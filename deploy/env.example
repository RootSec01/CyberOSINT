# Copy to deploy/.env on the server and fill in every value. Never commit the filled file.
DOMAIN=raqeeb.example.com
ACME_EMAIL=you@example.com

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32   (each one different)
JWT_SECRET=
OWNERSHIP_SECRET=

REQUIRE_OWNERSHIP_PROOF=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
FORCE_HTTPS=true
UNRESTRICTED_SCAN=false
LEGACY_API=false

# Scheduled scans and alerts
SCHEDULER_ENABLED=true
SCAN_INTERVAL_MINUTES=1440
SCHEDULER_TICK_SECONDS=30
ALERT_WEBHOOK_URL=
EGRESS_ALLOW_HOSTS=

# Your own servers that may be scanned, as comma-separated CIDRs (registry servers need nothing here)
AUTHORIZED_CIDRS=

# Shown on the Terms, Privacy and About pages and in /.well-known/security.txt
OPERATOR_NAME=
OPERATOR_CONTACT=
# Time zone used in reports and briefings, e.g. Asia/Dubai or Asia/Riyadh
TIMEZONE=Asia/Dubai

# Signs evidence files. Leave empty to generate one on first start (kept in the evidence volume).
EVIDENCE_SIGNING_KEY=

# Public showcase on https://DOMAIN:8443. Lab servers only, no route out, and an empty database on
# every start. Visitors enter without an account and can only look. Sign-in is switched off once the
# demo data is staged, so these accounts exist only inside the container; leave the passwords empty
# and random ones are generated.
SHOWCASE_ADMIN_USER=rami
SHOWCASE_ADMIN_PASSWORD=
SHOWCASE_VIEWER_USER=viewer
SHOWCASE_VIEWER_PASSWORD=
# openssl rand -hex 32   (each one different, and different from the ones above)
SHOWCASE_JWT_SECRET=
SHOWCASE_OWNERSHIP_SECRET=
# Serve the showcase on its own name (for example demo.example.org, pointed at this server).
# Left empty, it is served on https://DOMAIN:8443.
SHOWCASE_DOMAIN=
# A bare name to send to the showcase, for example example.org when DOMAIN is app.example.org.
ROOT_DOMAIN=
# The showcase starts over from an empty database on this interval, and one server alternates
# between its release and a planted change on the shorter one.
SHOWCASE_RESET_MINUTES=60
SHOWCASE_CYCLE_MINUTES=10

APP_ENV=production
WEB_CONCURRENCY=1
UVICORN_WORKERS=1
