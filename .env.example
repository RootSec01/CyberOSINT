# CyberOSINT — environment reference. Copy to .env and fill in.
# Secrets shown as <SET_ME>; never commit real values.

# ── External intelligence sources (optional; empty = that source is off) ──
SHODAN_API_KEY=
CENSYS_API_TOKEN=
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=

# ── AI copilot providers (keys read via the secrets backend, never the DB) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LOCAL_MODEL=llama3

# ── Secrets backend (production: move keys out of .env) ──
# env (default) | file  — 'file' reads a JSON object at SECRETS_FILE
SECRETS_BACKEND=env
SECRETS_FILE=

# ── Authentication / sessions ──
JWT_SECRET=<SET_ME_48_BYTES>        # python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_TTL_MINUTES=720

# ── Database: empty = SQLite; Postgres for production ──
DATABASE_URL=                       # postgresql+psycopg://user:pass@host:5432/cyberosint

# ── Active-scan authorization ──
AUTHORIZED_CIDRS=                    # comma-separated CIDRs allowed for active checks
UNRESTRICTED_SCAN=false             # keep false in production
REQUIRE_OWNERSHIP_PROOF=false       # true = domains need a DNS TXT proof before active scans
OWNERSHIP_SECRET=                   # optional; defaults to JWT_SECRET

# ── Monitoring scheduler (off unless enabled) ──
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=60
ALERT_WEBHOOK_URL=                  # optional: POST critical alerts (best-effort)

# ── Web hardening (production) ──
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORCE_HTTPS=false                   # true = redirect http->https + HSTS
RATE_LIMIT_ENABLED=false            # true = throttle (slowapi)
RATE_LIMIT_DEFAULT=240/minute
RATE_LIMIT_LOGIN=10/minute
