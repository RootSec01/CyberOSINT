[
 {
  "annotations": {
   "destructiveHint": true,
   "title": "Create an alert"
  },
  "description": "Create a stock alert on an item (type Quantity, e.g. threshold_method quantity_less_than with threshold_value 5, or less_than_or_equal_to_min_quantity), or a DateReminder on a datetime custom field (custom_attribute_id + before/after/same_day + threshold_interval). WRITE. Sortly: POST /api/v1/alerts.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "custom_attribute_id": {
     "description": "For DateReminder: the datetime custom field to watch.",
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "item_id": {
     "description": "The item the alert watches.",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "recipient_groups": {
     "description": "Who is notified: owners, admins, members, limited, or a custom role name. Default owners.",
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "threshold_interval": {
     "description": "Required for DateReminder; omit for Quantity.",
     "enum": [
      "days",
      "weeks",
      "months",
      "years"
     ],
     "type": "string"
    },
    "threshold_method": {
     "description": "What triggers it: a quantity_* method for Quantity, before/after/same_day for DateReminder.",
     "enum": [
      "less_than_or_equal_to_min_quantity",
      "quantity_greater_than",
      "quantity_less_than",
      "quantity_less_than_equal_to",
      "quantity_greater_than_equal_to",
      "before",
      "after",
      "same_day"
     ],
     "type": "string"
    },
    "threshold_value": {
     "description": "The number compared against (or the interval count).",
     "type": "number"
    },
    "type": {
     "description": "Quantity = stock threshold; DateReminder = date custom field.",
     "enum": [
      "Quantity",
      "DateReminder"
     ],
     "type": "string"
    }
   },
   "required": [
    "item_id",
    "type",
    "threshold_method"
   ],
   "type": "object"
  },
  "name": "sortly_create_alert",
  "output_schema": {},
  "title": "Create an alert"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "title": "Create an item or folder"
  },
  "description": "Create a trackable item (type item) or a folder (type folder), optionally inside a folder via parent_id, with quantity, price, tags, custom fields, barcodes and a measured quantity. WRITE. Sortly: POST /api/v1/items.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "custom_attribute_values": {
     "description": "Custom field values. Look up ids with sortly_list_custom_fields first.",
     "items": {
      "properties": {
       "custom_attribute_id": {
        "description": "Custom field id, from sortly_list_custom_fields.",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "value": {
        "description": "Value to store; null clears it.",
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "custom_attribute_id",
       "value"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "label_url": {
     "description": "Value encoded in the primary QR code / barcode.",
     "type": [
      "string",
      "null"
     ]
    },
    "label_url_extra": {
     "description": "Value encoded in the secondary code.",
     "type": [
      "string",
      "null"
     ]
    },
    "label_url_extra_type": {
     "anyOf": [
      {
       "enum": [
        "org.gs1.UPC-E",
        "org.iso.Code39",
        "org.iso.Code39Mod43",
        "org.gs1.EAN-13",
        "org.gs1.EAN-8",
        "com.intermec.Code93",
        "org.iso.Code128",
        "org.iso.PDF417",
        "org.iso.Aztec",
        "org.iso.QRCode",
        "org.ansi.Interleaved2of5",
        "org.iso.DataMatrix",
        "com.sortly.textEntry"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Symbology of the secondary code."
    },
    "label_url_type": {
     "anyOf": [
      {
       "enum": [
        "org.gs1.UPC-E",
        "org.iso.Code39",
        "org.iso.Code39Mod43",
        "org.gs1.EAN-13",
        "org.gs1.EAN-8",
        "com.intermec.Code93",
        "org.iso.Code128",
        "org.iso.PDF417",
        "org.iso.Aztec",
        "org.iso.QRCode",
        "org.ansi.Interleaved2of5",
        "org.iso.DataMatrix",
        "com.sortly.textEntry"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Symbology of the primary code."
    },
    "measured_quantity": {
     "description": "For items measured in something other than units.",
     "properties": {
      "name": {
       "description": "The unit, e.g. kg, ft, l, units (see sortly_list_units).",
       "enum": [
        "lbs",
        "g",
        "kg",
        "oz",
        "yd",
        "cm",
        "ft",
        "in",
        "m",
        "gal",
        "ml",
        "l",
        "ft3",
        "in3",
        "ft2",
        "in2",
        "units"
       ],
       "type": "string"
      },
      "type": {
       "description": "Kind of measurement; set on create only.",
       "enum": [
        "weight",
        "length",
        "volume",
        "area",
        "count"
       ],
       "type": "string"
      },
      "value": {
       "description": "The measured amount.",
       "type": "number"
      }
     },
     "required": [
      "value",
      "type",
      "name"
     ],
     "type": "object"
    },
    "min_quantity": {
     "description": "Minimum level; a Quantity alert can fire when stock reaches it.",
     "type": [
      "number",
      "null"
     ]
    },
    "name": {
     "description": "Name, max 190 characters.",
     "maxLength": 190,
     "minLength": 1,
     "type": "string"
    },
    "notes": {
     "description": "Free-text notes.",
     "type": [
      "string",
      "null"
     ]
    },
    "parent_id": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "description": "Folder to create it in. Omit/null = root."
    },
    "photo_ids": {
     "description": "Ids of photos already in the account to attach.",
     "items": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "type": "array"
    },
    "price": {
     "description": "Unit price.",
     "type": [
      "number",
      "null"
     ]
    },
    "quantity": {
     "description": "How many you have.",
     "type": [
      "number",
      "null"
     ]
    },
    "tags": {
     "description": "Tag names, e.g. [\"furniture\", \"used\"].",
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "type": {
     "description": "item = trackable stock; folder = a container.",
     "enum": [
      "item",
      "folder"
     ],
     "type": "string"
    }
   },
   "required": [
    "name",
    "type"
   ],
   "type": "object"
  },
  "name": "sortly_create_item",
  "output_schema": {},
  "title": "Create an item or folder"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "title": "Create a job"
  },
  "description": "Create a job (and its job folder) in not_started status. Name must be unique in the company. Then use sortly_pull_items_into_job to record the stock it uses. WRITE. Sortly: POST /api/v1/jobs.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "custom_field_values": {
     "description": "Up to 2 job custom field values.",
     "items": {
      "properties": {
       "custom_field_id": {
        "description": "Job custom field id.",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "value": {
        "description": "Value, max 191 characters.",
        "maxLength": 191,
        "type": "string"
       }
      },
      "required": [
       "custom_field_id",
       "value"
      ],
      "type": "object"
     },
     "maxItems": 2,
     "type": "array"
    },
    "end_date": {
     "description": "YYYY-MM-DD.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "external_job_link": {
     "description": "Link to the job in another system.",
     "format": "uri",
     "type": "string"
    },
    "name": {
     "description": "Unique job name, max 190 characters.",
     "maxLength": 190,
     "minLength": 1,
     "type": "string"
    },
    "notes": {
     "description": "Job notes, max 4000 characters.",
     "maxLength": 4000,
     "type": "string"
    },
    "start_date": {
     "description": "YYYY-MM-DD.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "subfolders": {
     "description": "Subfolder names to create, up to 25.",
     "items": {
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 25,
     "type": "array"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "name": "sortly_create_job",
  "output_schema": {},
  "title": "Create a job"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "title": "Draft a purchase order"
  },
  "description": "Create a purchase order in draft status (no stock or ordering happens until it is moved on in Sortly). Sortly computes amounts, sub_total and total from the lines; omit purchase_order_number to have one generated. Needs Purchase Orders on the plan (else 402). WRITE. Sortly: POST /api/v1/purchase_orders.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "bill_to": {
     "description": "Billing address.",
     "properties": {
      "city": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "line1": {
       "type": "string"
      },
      "line2": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "zip_code": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "charges": {
     "description": "Order-level charges; each defaults to 0.",
     "properties": {
      "discount": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?$",
         "type": "string"
        },
        {
         "type": "number"
        }
       ],
       "description": "A decimal, e.g. \"10\" or \"2.5\"."
      },
      "shipping_cost": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?$",
         "type": "string"
        },
        {
         "type": "number"
        }
       ],
       "description": "A decimal, e.g. \"10\" or \"2.5\"."
      },
      "tax": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?$",
         "type": "string"
        },
        {
         "type": "number"
        }
       ],
       "description": "A decimal, e.g. \"10\" or \"2.5\"."
      }
     },
     "type": "object"
    },
    "currency_code": {
     "description": "ISO 4217 code, e.g. USD.",
     "maxLength": 3,
     "minLength": 3,
     "type": "string"
    },
    "expected_delivery_date": {
     "description": "ISO 8601 timestamp, e.g. 2026-08-20T00:00:00Z.",
     "type": "string"
    },
    "line_items": {
     "description": "Up to 100 lines.",
     "items": {
      "properties": {
       "item_id": {
        "description": "Sortly item to order (must exist).",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "item_number": {
        "maxLength": 25,
        "type": "string"
       },
       "name": {
        "description": "Name recorded on the line.",
        "maxLength": 191,
        "minLength": 1,
        "type": "string"
       },
       "notes": {
        "maxLength": 314,
        "type": "string"
       },
       "quantity": {
        "anyOf": [
         {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
         },
         {
          "type": "number"
         }
        ],
        "description": "Quantity, e.g. \"10\" or 2.5."
       },
       "unit_of_measure": {
        "description": "Unit abbreviation, e.g. units, ft, kg.",
        "type": "string"
       },
       "unit_rate": {
        "anyOf": [
         {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
         },
         {
          "type": "number"
         }
        ],
        "description": "Price per unit. Omit for an unpriced line."
       },
       "variant_options": {
        "items": {
         "properties": {
          "name": {
           "type": "string"
          },
          "value": {
           "type": "string"
          }
         },
         "required": [
          "name",
          "value"
         ],
         "type": "object"
        },
        "maxItems": 3,
        "type": "array"
       }
      },
      "required": [
       "item_id",
       "name",
       "quantity",
       "unit_of_measure"
      ],
      "type": "object"
     },
     "maxItems": 100,
     "type": "array"
    },
    "notes": {
     "maxLength": 4000,
     "type": "string"
    },
    "purchase_order_number": {
     "description": "Unique PO number, max 20 chars. Omit to auto-generate.",
     "maxLength": 20,
     "type": "string"
    },
    "ship_to": {
     "description": "Shipping address.",
     "properties": {
      "city": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "line1": {
       "type": "string"
      },
      "line2": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "zip_code": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "terms": {
     "description": "e.g. Net 30.",
     "maxLength": 4000,
     "type": "string"
    },
    "vendor": {
     "description": "The vendor, captured on the PO.",
     "properties": {
      "city": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "email": {
       "maxLength": 190,
       "type": "string"
      },
      "line1": {
       "type": "string"
      },
      "line2": {
       "type": "string"
      },
      "name": {
       "maxLength": 50,
       "type": "string"
      },
      "phone": {
       "maxLength": 22,
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "zip_code": {
       "type": "string"
      }
     },
     "type": "object"
    }
   },
   "required": [
    "currency_code"
   ],
   "type": "object"
  },
  "name": "sortly_create_purchase_order",
  "output_schema": {},
  "title": "Draft a purchase order"
 },
