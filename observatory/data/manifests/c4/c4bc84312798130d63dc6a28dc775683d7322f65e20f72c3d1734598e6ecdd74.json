  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "name": {
     "description": "Jobs whose name starts with this (case-insensitive).",
     "type": "string"
    },
    "page": {
     "description": "Page number, starting at 1.",
     "maximum": 9007199254740991,
     "minimum": 1,
