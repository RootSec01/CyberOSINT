     "description": "Only the direct contents of this folder. Omit for the root level.",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "include": {
     "description": "Nested associations to embed: custom_attributes and/or photos.",
     "items": {
      "enum": [
       "custom_attributes",
       "photos"
      ],
      "type": "string"
     },
     "type": "array"
    },
    "include_subfolders": {
     "description": "With folder_id: also return everything nested beneath it. Default false.",
     "type": "boolean"
    },
    "page": {
     "description": "Page number, starting at 1.",
     "maximum": 9007199254740991,
     "minimum": 1,
     "type": "integer"
    },
    "per_page": {
     "description": "Page size, 1-1000 (default 10).",
     "maximum": 1000,
     "minimum": 1,
     "type": "integer"
    }
   },
   "type": "object"
  },
  "name": "sortly_list_items",
