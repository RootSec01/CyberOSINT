[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "Check Car Listing"
  },
  "description": "Use this when the user supplies a dealer vehicle listing and wants a best-practice score, missing data and prioritised fixes. Accepts at least a title (up to 300 characters) or description (up to 20,000), optional fields and up to 100 photo URL strings or a count. It does not fetch or scrape any website, verify vehicle facts or inspect images. Results are English; German and English keywords are recognised. Do not use for retrieving listings, valuations, vehicle inspections, media generation or legal advice. No images or videos are generated. No listing is stored or changed; operational call metrics are logged. Recommendations are not portal limits or legal advice.",
  "input_schema": {
   "additionalProperties": false,
   "anyOf": [
    {
     "required": [
      "title"
     ]
    },
    {
     "required": [
      "description"
     ]
    }
   ],
   "properties": {
    "description": {
     "description": "User supplied listing text; at least title or description must be nonblank.",
     "examples": [
      "Condition: minor wear. Service records available."
     ],
     "maxLength": 20000,
     "minLength": 1,
     "type": "string"
    },
    "fields": {
     "additionalProperties": false,
     "description": "Optional factual vehicle data; omitted values are unknown. Never inferred as verified.",
     "examples": [
      {
       "make": "Volkswagen",
       "mileage": 42000,
       "mileage_unit": "km",
       "model": "Golf"
      }
     ],
     "properties": {
      "accident_free": {
       "description": "Seller supplied accident-free statement; false means do not claim accident-free.",
       "examples": [
        true
       ],
       "type": "boolean"
      },
      "body_type": {
       "description": "Body style.",
       "examples": [
        "Hatchback"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "co2": {
       "description": "Applicable CO2 emissions including units/test cycle.",
       "examples": [
        "WLTP 132 g/km"
       ],
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "color": {
       "description": "Exterior colour.",
       "examples": [
        "Blue"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "condition": {
       "description": "New or used vehicle.",
       "enum": [
        "new",
        "used"
       ],
       "examples": [
        "used"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "consumption": {
       "description": "Applicable consumption figures including units/test cycle.",
       "examples": [
        "WLTP combined 5.8 l/100 km"
       ],
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "contact_provided": {
       "description": "Whether an actionable contact or viewing route is present.",
       "examples": [
        true
       ],
       "type": "boolean"
      },
      "currency": {
       "description": "Three-letter currency code.",
       "examples": [
        "EUR"
       ],
       "maxLength": 3,
       "minLength": 1,
       "pattern": "^[A-Z]{3}$",
       "type": "string"
      },
      "doors": {
       "description": "Door count.",
       "examples": [
        5
       ],
       "maximum": 10,
       "minimum": 0,
       "type": "integer"
      },
      "energy_efficiency": {
       "description": "Applicable energy-efficiency/CO2 class.",
       "examples": [
        "D"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "first_registration": {
       "description": "First registration month, YYYY-MM; not model year.",
       "examples": [
        "2021-06"
       ],
       "maxLength": 7,
       "minLength": 1,
       "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
       "type": "string"
      },
      "fuel_type": {
       "description": "Fuel or energy source.",
       "examples": [
        "Petrol"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "inspection_due": {
       "description": "Inspection expiry, e.g. HU/TÜV or MOT.",
       "examples": [
        "2027-06"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "known_damage": {
       "description": "Known damage requiring description and photos.",
       "examples": [
        true
       ],
       "type": "boolean"
      },
      "location": {
       "description": "Town or region only; no precise address required.",
       "examples": [
        "Berlin"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "make": {
       "description": "Manufacturer.",
       "examples": [
        "Volkswagen"
       ],
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "mileage": {
       "description": "Odometer reading; zero is valid.",
       "examples": [
        42000
       ],
       "maximum": 10000000,
       "minimum": 0,
       "type": "number"
      },
      "mileage_unit": {
       "description": "Odometer unit.",
       "enum": [
        "km",
        "mi"
       ],
       "examples": [
        "km"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "model": {
       "description": "Model.",
       "examples": [
        "Golf"
       ],
       "maxLength": 180,
       "minLength": 1,
       "type": "string"
      },
      "model_year": {
       "description": "Model year, particularly useful in US listings.",
       "examples": [
        2021
       ],
       "maximum": 2100,
       "minimum": 0,
       "type": "integer"
      },
      "power_hp": {
       "description": "Rated power in hp.",
       "examples": [
        150
       ],
       "maximum": 4000,
       "minimum": 0,
       "type": "number"
      },
      "power_kw": {
       "description": "Rated power in kW.",
       "examples": [
        110
       ],
       "maximum": 3000,
       "minimum": 0,
       "type": "number"
      },
      "previous_owners": {
       "description": "Previous owner count.",
       "examples": [
        1
       ],
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "price": {
       "description": "Full asking price, not a monthly payment.",
       "examples": [
        18900
       ],
       "maximum": 100000000,
       "minimum": 0,
       "type": "number"
      },
      "seats": {
       "description": "Seat count.",
       "examples": [
        5
       ],
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "service_history": {
       "description": "Documented service history or explicitly unknown.",
       "examples": [
        "Service records available"
       ],
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "transmission": {
       "description": "Transmission type.",
       "examples": [
        "Automatic"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "variant": {
       "description": "Trim or engine variant.",
       "examples": [
        "1.5 TSI"
       ],
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "vin_provided": {
       "description": "Whether a VIN is supplied in the listing; do not send the VIN here.",
       "examples": [
        true
       ],
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "has_walkaround_video": {
     "description": "Seller reports an actual walkaround video.",
     "examples": [
      true
     ],
     "type": "boolean"
    },
    "image_urls": {
     "description": "Image URL strings only, never fetched. If supplied, their count takes precedence over photo_count.",
     "examples": [
      [
       "https://example.org/front_3_4.jpg"
      ]
     ],
     "items": {
      "description": "Unfetched image URL.",
      "examples": [
       "https://example.org/front_3_4.jpg"
      ],
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 100,
     "type": "array"
    },
    "language": {
     "default": "auto",
     "description": "Input language: de/en overrides market and text detection. Auto or omitted uses market first, then German/English text heuristics; generic gives no language hint. Results remain English.",
     "enum": [
      "auto",
      "de",
      "en"
     ],
     "examples": [
      "auto"
     ],
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "market": {
     "default": "generic",
     "description": "Market guidance and language hint (de/DE/at/AT/ch/CH: German; us/uk: English). Explicit language wins. DE uses German guidance; AT/CH use generic guidance; no legal compliance determination.",
     "enum": [
      "de",
      "DE",
      "at",
      "AT",
      "ch",
      "CH",
      "us",
      "uk",
      "generic"
     ],
     "examples": [
      "generic"
     ],
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "photo_count": {
     "description": "Photo count when image_urls are unavailable.",
     "examples": [
      12
     ],
     "maximum": 100,
     "minimum": 0,
     "type": "integer"
    },
    "photo_order": {
     "description": "Shot labels in actual order; takes precedence over filename hints.",
     "examples": [
      [
       "front_3_4",
       "side",
       "rear"
      ]
     ],
     "items": {
      "description": "Recognised shot label.",
      "enum": [
       "front_3_4",
       "side",
       "rear",
       "interior_front",
       "dashboard",
       "odometer",
       "trunk",
       "wheels",
       "engine",
       "damage"
      ],
      "examples": [
       "front_3_4"
      ],
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 100,
     "type": "array"
    },
    "title": {
     "description": "Listing title; at least title or description must be nonblank.",
     "examples": [
      "Volkswagen Golf 1.5 TSI Automatic"
     ],
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "video_url": {
     "description": "Video URL string; presence only, never fetched.",
     "examples": [
      "https://example.org/walkaround.mp4"
     ],
     "maxLength": 2048,
     "minLength": 1,
     "type": "string"
    }
   },
   "type": "object"
  },
  "name": "check_car_listing",
