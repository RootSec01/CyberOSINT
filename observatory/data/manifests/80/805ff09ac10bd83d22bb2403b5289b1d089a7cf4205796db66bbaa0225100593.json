   "title": "Calculate critical path"
  },
  "description": "Use this when the user wants a critical path calculation, project duration, earliest/latest task starts and finishes, or task slack from explicit durations and dependencies. Accepts one to forty tasks, at most 160 finish-to-start dependencies, and durations with at most three decimal places. Includes parallel critical tasks and a CSV schedule. Does not schedule calendar dates, generate Gantt charts, account for resources or holidays, or infer missing task durations.",
  "execution": {
   "taskSupport": "forbidden"
  },
  "input_schema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "properties": {
    "project": {
     "description": "Project label, e.g. Website launch.",
     "maxLength": 80,
     "type": "string"
    },
    "tasks": {
     "description": "Tasks in any order, e.g. [{\"id\":\"A\",\"duration\":3},{\"id\":\"B\",\"duration\":5,\"depends_on\":[\"A\"]}].",
     "items": {
      "properties": {
       "depends_on": {
        "description": "Finish-to-start predecessor IDs, e.g. [\"design\"]. Omit for a starting task.",
        "items": {
         "description": "Predecessor task ID, e.g. design.",
         "maxLength": 20,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 39,
        "type": "array"
       },
       "duration": {
        "description": "Elapsed duration in the chosen unit, with at most three decimal places, e.g. 2.5. Zero denotes a milestone.",
        "maximum": 1000000,
        "minimum": 0,
        "type": "number"
       },
       "id": {
        "description": "Unique dependency ID, e.g. design.",
        "maxLength": 20,
        "minLength": 1,
        "type": "string"
       },
       "name": {
        "description": "Task label, e.g. Design mockups. Defaults to its ID.",
        "maxLength": 50,
        "type": "string"
       }
      },
      "required": [
       "id",
       "duration"
      ],
      "type": "object"
     },
     "maxItems": 40,
     "minItems": 1,
     "type": "array"
    },
    "unit": {
     "description": "A single elapsed-time unit for all task durations, e.g. days. Defaults to days; no business calendar is applied.",
     "enum": [
      "days",
      "hours",
      "weeks"
     ],
     "type": "string"
    }
   },
   "required": [
    "tasks"
   ],
   "type": "object"
  },
