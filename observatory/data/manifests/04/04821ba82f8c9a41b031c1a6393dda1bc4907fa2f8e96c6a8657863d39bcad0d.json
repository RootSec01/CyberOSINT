 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "A Thanksgiving cooking schedule worked back from the dinner time: what to do on each day before (thawing, make-ahead dishes), when the turkey goes in and comes out, which oven each side dish goes in and when, and any dish that does not fit the ovens, with fixes. Turkey times are USDA FSIS's; dish times are each recipe's own. Every setting is optional.",
  "icons": [
   {
    "mimeType": "image/png",
    "sizes": [
     "128x128"
    ],
    "src": "https://plateartists.com/brand/logo-mark-light-128.png",
    "theme": "light"
   },
   {
    "mimeType": "image/png",
    "sizes": [
     "128x128"
    ],
    "src": "https://plateartists.com/brand/logo-mark-dark-128.png",
    "theme": "dark"
   }
  ],
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "date": {
     "description": "Dinner date YYYY-MM-DD (default: the next US Thanksgiving)",
     "maxLength": 10,
     "type": "string"
    },
    "dinner_time": {
     "description": "24-hour HH:MM the food is on the table (default \"16:00\")",
     "maxLength": 5,
     "type": "string"
    },
    "dish_beside_turkey": {
     "description": "A side dish fits on a rack beside the turkey",
     "type": "boolean"
    },
    "dishes": {
     "description": "Dishes on the menu (default: mashed, gravy, stuffing, green-beans, rolls, cranberry, pumpkin-pie, pecan-pie). mashed = Mashed potatoes, gravy = Turkey gravy, stuffing = Stuffing, baked in a dish, green-beans = Green bean casserole, sweet-potato = Sweet potato casserole, scalloped = Scalloped potatoes, mac = Baked mac and cheese, sprouts = Roasted Brussels sprouts, rolls = Dinner rolls, cranberry = Cranberry sauce, pumpkin-pie = Pumpkin pie, pecan-pie = Pecan pie",
     "items": {
      "enum": [
       "mashed",
       "gravy",
       "stuffing",
       "green-beans",
       "sweet-potato",
       "scalloped",
       "mac",
       "sprouts",
       "rolls",
       "cranberry",
       "pumpkin-pie",
       "pecan-pie"
      ],
      "type": "string"
     },
     "maxItems": 12,
     "type": "array"
    },
    "kitchen": {
     "description": "one oven (default), one oven plus a countertop oven, or two ovens",
     "enum": [
      "one",
      "countertop",
      "two"
     ],
     "type": "string"
    },
    "stuffed": {
     "description": "Roasting with stuffing inside the bird",
     "type": "boolean"
    },
    "thaw": {
     "description": "fridge (default), cold water, or fresh = no thawing",
     "enum": [
      "fridge",
      "water",
      "fresh"
     ],
     "type": "string"
    },
    "turkey_lb": {
     "description": "Turkey weight in pounds, 4 to 24 (default 16; kg × 2.2)",
     "maximum": 24,
     "minimum": 4,
     "type": "number"
    }
   },
   "type": "object"
  },
  "name": "thanksgiving_timeline",
  "output_schema": {},
  "title": "Thanksgiving timeline planner"
 },
