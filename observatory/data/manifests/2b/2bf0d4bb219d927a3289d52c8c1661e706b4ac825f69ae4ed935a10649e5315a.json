   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Find free ready-made PriorStates Studio Gallery apps for a need described in plain words, in English, Chinese, Spanish or Portuguese (e.g. 'split a dinner bill', 'keep my receipts for taxes', '分账', 'recibos'). Returns the best matches with what each does, a page link, a screenshot and how to open it. If nothing fits, Studio can make a new app from the description.",
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "language": {
     "description": "Language for the reply's app text and links: en, zh (Simplified Chinese), zh-hant (Traditional Chinese), es, pt. Default en (zh when the need is written in Chinese).",
     "enum": [
      "en",
      "zh",
      "zh-hant",
      "es",
      "pt"
     ],
     "type": "string"
    },
    "limit": {
     "default": 3,
     "description": "How many apps at most (1-10, default 3).",
     "maximum": 10,
     "minimum": 1,
     "type": "integer"
    },
    "need": {
     "description": "What the person wants to do, in their own words.",
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "need"
   ],
   "type": "object"
  },
  "name": "find_apps",
  "output_schema": {
   "properties": {
    "apps": {
     "items": {
      "properties": {
       "gallery_page": {
        "type": "string"
       },
       "group": {
        "type": "string"
       },
       "group_id": {
        "type": "string"
       },
       "icon": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "open_on_web": {
        "type": "string"
       },
       "screenshot": {
        "type": "string"
       },
       "what_it_does": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "what_it_does",
       "gallery_page"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "confident": {
     "type": "boolean"
    },
    "language": {
     "type": "string"
    },
    "make_new": {
     "properties": {
      "text": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "need": {
     "type": "string"
    }
   },
   "required": [
    "need",
    "language",
    "apps",
    "confident"
   ],
   "type": "object"
  },
  "title": "Find a free app for a need"
 },
