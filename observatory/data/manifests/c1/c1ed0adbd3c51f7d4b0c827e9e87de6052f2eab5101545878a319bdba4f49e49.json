 {
  "annotations": {
   "destructiveHint": true,
   "title": "Create a customer"
  },
  "description": "WRITE: create a new customer. Each call creates a new record (not idempotent). Craftboxx API: POST /customers.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "customer_number": {
     "description": "Your own customer number.",
     "type": "string"
    },
    "info": {
     "description": "Free-text note.",
     "type": "string"
    },
    "name": {
     "description": "Customer name (required).",
     "minLength": 1,
     "type": "string"
    },
    "name_addon": {
     "description": "Name addition, such as a second line.",
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "name": "craftboxx_create_customer",
  "output_schema": {},
  "title": "Create a customer"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "title": "Create a project"
  },
  "description": "WRITE: create a new project for an existing customer. Each call creates a new record (not idempotent). Craftboxx API: POST /projects.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "customer_id": {
     "description": "Id of the customer (required, see craftboxx_list_customers).",
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "project_nr": {
     "description": "Your own project number.",
     "type": "string"
    },
    "title": {
     "description": "Project title (required).",
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "title",
    "customer_id"
   ],
   "type": "object"
  },
  "name": "craftboxx_create_project",
  "output_schema": {},
  "title": "Create a project"
