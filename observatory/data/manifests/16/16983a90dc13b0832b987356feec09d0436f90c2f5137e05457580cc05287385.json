 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": true,
   "readOnlyHint": true,
   "title": "Summarize activities on selected leads"
  },
  "description": "Count logged activity comments by their author and activity type/outcome for 1–20 selected leads in an inclusive date range. Choose a reporting time zone (default UTC) and optionally user ids. Calls GET /activities once and GET /leads/{id}/comments once per lead, up to 21 vendor requests before retries. Parent grouping combines outcomes such as answered/unanswered under Call without double counting. This is a lead-scoped report: excludes activities without a lead, other leads, ordinary notes and reminders; it cannot reproduce account-wide Statistics > Activity. Use noCRM's Team's activity export for that report. Unknown activity ids remain in the counts with a null name. A failed or malformed source returns an error, never partial totals.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "from": {
     "description": "First reporting day, inclusive (yyyy-mm-dd).",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "group_by": {
     "description": "outcome (default) keeps answered/unanswered distinct; parent_activity combines them under their parent activity.",
     "enum": [
      "outcome",
      "parent_activity"
     ],
     "type": "string"
    },
    "lead_ids": {
     "description": "Explicit lead ids to report on, 1–20. Discover them with nocrm_list_leads; this tool does not scan the account.",
     "items": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "time_zone": {
     "description": "IANA time zone used to assign timestamps to days, e.g. Europe/Prague. Default UTC; choose the account's zone to compare with UI dates.",
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "to": {
     "description": "Last reporting day, inclusive (yyyy-mm-dd).",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "user_ids": {
     "description": "Only activities authored by these users, regardless of the lead's owner. See nocrm_list_users.",
     "items": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "maxItems": 100,
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "lead_ids",
    "from",
    "to"
   ],
   "type": "object"
  },
  "name": "nocrm_summarize_lead_activities",
  "output_schema": {},
  "title": "Summarize activities on selected leads"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": false,
   "openWorldHint": true,
   "readOnlyHint": false,
   "title": "Update lead"
  },
  "description": "WRITE: change a lead: title, status (won, lost, cancelled, todo or standby), pipeline step, amount, probability, star, estimated closing date, tags (replaces the lead's tag list), or append text to the description (existing description text is never replaced). Moving to standby needs remind_date. Only the fields you pass change. PUT /leads/{id}.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "amount": {
     "description": "Deal amount in the account currency.",
     "maximum": 1000000000000,
     "minimum": 0,
     "type": "number"
    },
    "append_description": {
     "description": "Text added at the end of the description.",
     "maxLength": 20000,
     "minLength": 1,
     "type": "string"
    },
    "estimated_closing_date": {
     "description": "yyyy-mm-dd, in the account's time zone.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "lead_id": {
     "description": "noCRM.io lead id.",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "probability": {
     "description": "Win probability, percent.",
     "maximum": 100,
     "minimum": 0,
     "type": "integer"
    },
    "remind_date": {
     "description": "Reminder date yyyy-mm-dd (required for standby).",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "remind_time": {
     "description": "Reminder time HH:MM, 24 h, in 15-minute steps.",
     "pattern": "^([01]\\d|2[0-3]):(00|15|30|45)$",
     "type": "string"
    },
    "reminder_note": {
     "description": "Note stored with the reminder.",
     "maxLength": 2000,
     "type": "string"
    },
    "starred": {
     "type": "boolean"
    },
    "status": {
     "description": "New status. standby needs remind_date.",
     "enum": [
      "todo",
      "standby",
      "won",
      "cancelled",
      "lost"
     ],
     "type": "string"
    },
    "step": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     ],
     "description": "Move to this step (id or exact name; prefer the id when pipelines share names)."
    },
    "tags": {
     "description": "The lead's tags after the update (replaces the current list; new tags are created).",
     "items": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 30,
     "type": "array"
    },
    "title": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "lead_id"
   ],
   "type": "object"
  },
  "name": "nocrm_update_lead",
  "output_schema": {},
  "title": "Update lead"
 }
]
