 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": true,
   "readOnlyHint": true,
   "title": "List lead history"
  },
  "description": "The timeline of a lead: creation, assignments, step and status changes, amount changes, comments and emails sent, with who did it and when. Filter by date range, action type or user. GET /leads/{id}/action_histories.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "action_type": {
     "description": "Only this kind of action.",
     "enum": [
      "client_assigned",
      "step_changed",
      "status_changed",
      "amount_set",
      "user_assigned",
      "lead_created",
      "comment_added",
      "email_sent"
     ],
     "type": "string"
    },
    "direction": {
     "description": "Sort by id (default asc).",
     "enum": [
      "asc",
      "desc"
     ],
     "type": "string"
    },
    "from": {
     "description": "From this date (yyyy-mm-dd).",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "lead_id": {
     "description": "noCRM.io lead id.",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "limit": {
     "description": "Results per call, 1-100 (default 25).",
     "exclusiveMinimum": 0,
     "maximum": 100,
     "type": "integer"
    },
    "offset": {
     "description": "Skip this many results (default 0). Pass the previous reply's next_offset.",
     "maximum": 1000000,
     "minimum": 0,
     "type": "integer"
    },
    "to": {
     "description": "Until this date (yyyy-mm-dd).",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    }
   },
   "required": [
    "lead_id"
   ],
   "type": "object"
  },
  "name": "nocrm_list_lead_history",
  "output_schema": {},
  "title": "List lead history"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": true,
   "readOnlyHint": true,
   "title": "List leads"
  },
  "description": "List or search sales leads (noCRM.io's opportunities), newest first by default, with title, pipeline step, status, amount, probability, tags, owner, next reminder and the contact details in the description. Filter by status, step (names or ids, not mixed), owner, tags, email, starred or a date range. Unassigned leads are excluded unless include_unassigned is true. GET /leads.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "date_range_type": {
     "description": "Which date start_date/end_date apply to (default creation).",
     "enum": [
      "creation",
      "update",
      "next_action",
      "closed"
     ],
     "type": "string"
    },
    "direction": {
     "description": "Sort direction (default desc).",
     "enum": [
      "asc",
      "desc"
     ],
     "type": "string"
    },
    "email": {
     "description": "Only leads whose description or comments contain this email address.",
     "maxLength": 200,
     "minLength": 3,
     "type": "string"
    },
    "end_date": {
     "description": "Until this date (yyyy-mm-dd), by date_range_type.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "include_unassigned": {
     "description": "Also return leads that have no owner (default false).",
     "type": "boolean"
    },
    "limit": {
     "description": "Results per call, 1-100 (default 25).",
     "exclusiveMinimum": 0,
     "maximum": 100,
     "type": "integer"
    },
    "offset": {
     "description": "Skip this many results (default 0). Pass the previous reply's next_offset.",
     "maximum": 1000000,
     "minimum": 0,
     "type": "integer"
    },
    "order": {
     "description": "Sort attribute (default id).",
     "enum": [
      "id",
      "creation_date",
      "last_update",
      "next_action",
      "sale_step",
      "amount",
      "probability",
      "probalized_amount",
      "alphabetically"
     ],
     "type": "string"
    },
    "starred": {
     "description": "true = only starred leads.",
     "type": "boolean"
    },
    "start_date": {
     "description": "From this date (yyyy-mm-dd), by date_range_type.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "status": {
     "description": "Only leads in these statuses (todo = to do, standby = waiting for a reminder date).",
     "items": {
      "enum": [
       "todo",
       "standby",
       "won",
       "cancelled",
       "lost"
      ],
      "type": "string"
     },
     "maxItems": 5,
     "minItems": 1,
     "type": "array"
    },
    "steps": {
     "anyOf": [
      {
       "items": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "maxItems": 30,
       "minItems": 1,
       "type": "array"
      },
      {
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 30,
       "minItems": 1,
       "type": "array"
      }
     ],
     "description": "Only leads in these pipeline steps: exact step names OR step ids (not mixed). See nocrm_list_steps."
    },
    "tags": {
     "description": "Only leads carrying ALL of these tags.",
     "items": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "updated_after": {
     "description": "Only leads updated on or after this date (yyyy-mm-dd). Do not combine with date_range_type.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "user_id": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     ],
     "description": "Only leads owned by this user (id or email)."
    }
   },
   "type": "object"
  },
  "name": "nocrm_list_leads",
  "output_schema": {},
  "title": "List leads"
 },
