 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": true,
   "readOnlyHint": false,
   "title": "Create lead"
  },
  "description": "WRITE: create a new lead. The description holds the contact's details, one 'Label: value' per line (for example 'Firstname: Ada', 'Email: ada@example.com', 'Phone: ...'); noCRM.io reads those lines. Without user_id the lead is created unassigned; a pipeline step can only be set when the lead is assigned. Not idempotent: calling twice creates two leads. POST /leads.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "description": {
     "description": "Contact details and notes, one 'Label: value' per line.",
     "maxLength": 20000,
     "minLength": 1,
     "type": "string"
    },
    "step": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     ],
     "description": "Pipeline step id or exact name. Needs user_id."
    },
    "tags": {
     "description": "Tags (created if new).",
     "items": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 30,
     "type": "array"
    },
    "title": {
     "description": "Lead title, usually the company name.",
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "user_id": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     ],
     "description": "Owner (id or email). Omit for an unassigned lead."
    }
   },
   "required": [
    "title",
    "description"
   ],
   "type": "object"
  },
  "name": "nocrm_create_lead",
  "output_schema": {},
  "title": "Create lead"
 },
