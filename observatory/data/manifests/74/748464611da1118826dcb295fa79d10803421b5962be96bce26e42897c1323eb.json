    "limit": {
     "description": "How many events to return. Default 20, maximum 40.",
     "type": "integer"
    },
    "types": {
     "description": "Only these event types.",
     "items": {
      "enum": [
       "deposit",
       "withdraw",
       "buy",
       "compound",
       "transfer",
       "rebalance",
       "targets_updated"
      ],
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "address"
   ],
   "type": "object"
  },
  "name": "get_user_activity",
