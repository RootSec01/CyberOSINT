 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "description": "Open a new USDC, Bitcoin, Ethereum or MAMO Account for a wallet. Needs a message from `prepare_sign_in` and the wallet's signature over it. Mamo's backend deploys the Account and pays the gas, because one opened any other way is not compounded or rebalanced. This server signs and sends nothing: the signature is forwarded once and never stored. It does not expire and cannot be revoked: pass it here only, and expect it to stay in this client's transcript. Answers `pending` (queued; poll `get_account_creation_status` before depositing) or `exists` (nothing sent). Never opens a second Account of a kind.",
  "input_schema": {
   "properties": {
    "account": {
     "description": "Which Account to open: `usdc_stablecoin` (USDC Account), `cbbtc_lending` (Bitcoin Account), `eth_lending` (Ethereum Account), `mamo_staking` (MAMO Account).",
     "enum": [
      "usdc_stablecoin",
      "cbbtc_lending",
      "eth_lending",
      "mamo_staking"
     ],
     "type": "string"
    },
    "address": {
     "description": "The wallet that will own the Account, 0x-prefixed, on Base.",
     "type": "string"
    },
    "message": {
     "description": "The sign-in text from `prepare_sign_in`, byte for byte. Anything else is rejected.",
     "type": "string"
    },
    "signature": {
     "description": "That wallet's `personal_sign` signature over `message`, 0x-prefixed hex.",
     "type": "string"
    }
   },
   "required": [
    "address",
    "account",
    "message",
    "signature"
   ],
   "type": "object"
  },
  "name": "create_account",
  "output_schema": {
   "properties": {
    "data": {
     "properties": {
      "account": {},
      "budgetSeconds": {},
      "name": {
       "type": "string"
      },
      "pollAfterSeconds": {},
      "proxy": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "requestedAt": {
       "type": "string"
      },
      "status": {
       "enum": [
        "pending",
        "exists"
       ],
       "type": "string"
      }
     },
     "required": [
      "status",
      "account",
      "name",
      "proxy",
      "requestedAt",
      "pollAfterSeconds",
      "budgetSeconds"
     ],
     "type": [
      "object",
      "null"
     ]
    },
    "warnings": {
     "items": {
      "properties": {
       "code": {
        "type": "string"
       },
       "severity": {
        "enum": [
         "info",
         "warning",
         "error"
        ]
       }
      }
     },
     "type": "array"
    }
   },
   "type": "object"
  },
  "title": "Open a Mamo Account"
