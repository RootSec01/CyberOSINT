 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false,
   "title": "Ask B.R.M to contact the user"
  },
  "description": "Sends the user's request to the B.R.M team: 'appointment' (private visit of the manufacture — a booking link is returned), 'quote' (personalised quote by email), or 'special_request' (anything the configurator does not offer; the workshop checks feasibility). Requires the user's explicit agreement to share their email and be contacted (user_consent=true). The message cannot be recalled once sent. Never an order, never a payment. Limited to a few requests per day.",
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "configuration": {
     "additionalProperties": false,
     "properties": {
      "engraving": {
       "description": "Optional engraving text (not priced, not rendered).",
       "maxLength": 24,
       "type": "string"
      },
      "model": {
       "description": "model_id from list_models, e.g. 'v6-44-sa'.",
       "type": "string"
      },
      "options": {
       "description": "option_id values from describe_model. Unset components keep their default.",
       "items": {
        "type": "string"
       },
       "maxItems": 40,
       "type": "array"
      }
     },
     "required": [
      "model"
     ],
     "type": "object"
    },
    "contact": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "format": "email",
       "type": "string"
      },
      "name": {
       "maxLength": 120,
       "type": "string"
      },
      "phone": {
       "maxLength": 40,
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "country": {
     "type": "string"
    },
    "idempotency_key": {
     "maxLength": 80,
     "type": "string"
    },
    "kind": {
     "enum": [
      "appointment",
      "quote",
      "special_request"
     ],
     "type": "string"
    },
