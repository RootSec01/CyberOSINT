      "ja",
      "ko",
      "zh",
      "ar",
      "hi"
     ],
     "type": "string"
    },
    "model": {
     "type": "string"
    }
   },
   "required": [
    "model"
   ],
   "type": "object"
  },
  "name": "describe_model",
  "output_schema": {
   "properties": {
