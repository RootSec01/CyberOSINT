     "type": "number"
    },
    "components": {
     "items": {
      "properties": {
       "component_id": {
        "type": "string"
       },
       "conditional": {
        "type": "boolean"
       },
       "depends_on": {
        "description": "The component exists only if ONE of these option_ids is selected.",
        "items": {
         "type": "string"
        },
