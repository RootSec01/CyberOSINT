[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Estimate the hard-disk storage a CCTV system needs and suggest a disk size. Same calculation as https://utechit.pk/tools/cctv-hard-disk-storage-calculator",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "cameras": {
     "maximum": 512,
     "minimum": 1,
     "type": "integer"
    },
    "codec": {
     "default": "h265",
     "enum": [
      "h264",
      "h265",
      "h265+"
     ],
     "type": "string"
    },
    "days": {
     "default": 30,
     "description": "Days of recording to keep",
     "maximum": 365,
     "minimum": 1,
     "type": "integer"
    },
    "hoursPerDay": {
     "default": 24,
     "maximum": 24,
     "minimum": 1,
     "type": "number"
    },
    "motionPercent": {
     "default": 100,
     "description": "Share of time recorded; 100 = continuous",
     "maximum": 100,
     "minimum": 5,
     "type": "number"
    },
    "resolution": {
     "default": "4mp",
     "enum": [
      "2mp",
      "4mp",
      "5mp",
      "8mp"
     ],
     "type": "string"
    }
   },
   "required": [
    "cameras"
   ],
   "type": "object"
  },
  "name": "calculate_cctv_storage",
  "output_schema": {},
  "title": "CCTV storage calculator"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Estimate how long a battery bank runs a load (e.g. during load-shedding), the battery capacity needed for a target time, and a minimum UPS rating. Same calculation as https://utechit.pk/tools/ups-battery-backup-time-calculator",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "batteryAh": {
     "default": 200,
     "maximum": 10000,
     "minimum": 1,
     "type": "number"
    },
    "batteryType": {
     "default": "lithium",
     "enum": [
      "lithium",
      "lead-acid"
     ],
     "type": "string"
    },
    "batteryVolts": {
     "default": 24,
     "maximum": 480,
     "minimum": 12,
     "type": "number"
    },
    "inverterEfficiencyPercent": {
     "default": 90,
     "maximum": 99,
     "minimum": 50,
     "type": "number"
    },
    "loadWatts": {
     "maximum": 100000,
     "minimum": 1,
     "type": "number"
    },
    "targetHours": {
     "default": 4,
     "maximum": 72,
     "minimum": 0.25,
     "type": "number"
    }
   },
   "required": [
    "loadWatts"
   ],
   "type": "object"
  },
  "name": "calculate_ups_backup",
  "output_schema": {},
  "title": "UPS backup time calculator"
 },
