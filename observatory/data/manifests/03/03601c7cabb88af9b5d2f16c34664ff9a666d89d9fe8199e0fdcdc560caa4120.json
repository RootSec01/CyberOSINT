 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": true,
   "title": "Search claims"
  },
  "description": "Search individual assertions rather than whole papers. Returns claims with\n    the verbatim source quote each rests on, its scope conditions, and the sha256\n    of the source PDF.\n\n    Ask in natural language. Stopwords and punctuation are stripped, so\n    \"what makes reputation systems work for autonomous agents\" is treated as\n    the terms that carry meaning; a strict every-token match would return\n    nothing, since no claim contains the word \"what\".\n\n    match:\n      \"relevance\" score by term overlap, exact phrase ranked first (default)\n      \"all\"       every meaningful term must appear\n      \"phrase\"    the exact phrase must appear\n\n    claim_type filters to: failure, mechanism, empirical, design, condition,\n    definitional, predictive, normative.\n    ",
  "input_schema": {
   "properties": {
    "claim_type": {
     "default": "",
     "title": "Claim Type",
     "type": "string"
    },
    "failure_modes_only": {
     "default": false,
     "title": "Failure Modes Only",
     "type": "boolean"
    },
    "limit": {
     "default": 10,
     "title": "Limit",
     "type": "integer"
    },
    "match": {
     "default": "relevance",
     "title": "Match",
     "type": "string"
    },
    "query": {
     "title": "Query",
     "type": "string"
    }
   },
   "required": [
    "query"
   ],
   "title": "search_claimsArguments",
   "type": "object"
  },
  "name": "search_claims",
  "output_schema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "search_claimsOutput",
   "type": "object"
  }
 },
