     "description": "Customer numbers.",
     "items": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "type": "array"
    },
    "limit": {
     "description": "Results per page, 1 to 100.",
     "maximum": 100,
     "minimum": 1,
     "type": "integer"
    },
    "page": {
     "description": "Page number, counting from 0 (default 0).",
     "maximum": 9007199254740991,
     "minimum": 0,
     "type": "integer"
    },
    "text": {
     "description": "Text searched in customer data.",
     "type": "string"
    }
   },
   "type": "object"
  },
  "name": "idosell_search_customers",
  "output_schema": {},
  "title": "Search customers"
 },
 {
  "annotations": {
   "readOnlyHint": true,
   "title": "Search orders"
  },
  "description": "Search orders by status, date range, customer, order ids or serial numbers. Returns order details with products, payments, dispatch data and the customer. Read-only (a POST search). API: POST /orders/orders/search.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "customer_email": {
     "description": "Customer e-mail address.",
     "type": "string"
    },
    "customer_login": {
     "description": "Customer login.",
     "type": "string"
    },
    "date_from": {
     "description": "Range start, YYYY-MM-DD or YYYY-MM-DD HH:MM:SS.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}:\\d{2})?$",
     "type": "string"
    },
    "date_to": {
     "description": "Range end, YYYY-MM-DD or YYYY-MM-DD HH:MM:SS.",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}:\\d{2})?$",
     "type": "string"
    },
    "date_type": {
     "description": "Which date the range applies to (default add = order placed).",
     "enum": [
      "add",
      "modified",
      "dispatch",
      "payment",
      "last_payments_operation",
      "declared_payments"
     ],
     "type": "string"
    },
    "limit": {
     "description": "Results per page, 1 to 100.",
     "maximum": 100,
     "minimum": 1,
     "type": "integer"
    },
    "orders_ids": {
     "description": "Order ids.",
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "page": {
     "description": "Page number, counting from 0 (default 0).",
     "maximum": 9007199254740991,
     "minimum": 0,
     "type": "integer"
    },
    "serial_numbers": {
     "description": "Order serial numbers (max 100).",
     "items": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "maxItems": 100,
     "type": "array"
    },
    "statuses": {
     "description": "Only orders in these statuses.",
     "items": {
      "enum": [
       "new",
       "finished",
       "false",
       "lost",
       "on_order",
       "packed",
       "ready",
       "canceled",
       "payment_waiting",
       "delivery_waiting",
       "suspended",
       "joined",
       "finished_ext"
      ],
      "type": "string"
     },
     "type": "array"
    }
   },
   "type": "object"
  },
  "name": "idosell_search_orders",
  "output_schema": {},
  "title": "Search orders"
 },
 {
  "annotations": {
   "readOnlyHint": true,
   "title": "Search products"
  },
  "description": "Search products by text, code, availability, visibility or promotion. Returns prices, stock summary, images and categories. Read-only (a POST search). API: POST /products/products/search.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "available": {
     "description": "true = only available products, false = only unavailable.",
     "type": "boolean"
    },
    "code_part": {
     "description": "Product code, or a part of it (producer, external or panel code).",
     "type": "string"
    },
    "in_promotion": {
     "description": "true = only products in promotion.",
     "type": "boolean"
    },
    "limit": {
     "description": "Results per page, 1 to 100.",
     "maximum": 100,
     "minimum": 1,
     "type": "integer"
    },
    "page": {
     "description": "Page number, counting from 0 (default 0).",
     "maximum": 9007199254740991,
     "minimum": 0,
     "type": "integer"
    },
    "product_ids": {
     "description": "Product ids.",
     "items": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "type": "array"
    },
    "text": {
     "description": "Text found in the name or description.",
     "type": "string"
    },
    "visible": {
     "description": "true = only products visible in the shop.",
     "type": "boolean"
    }
   },
   "type": "object"
  },
  "name": "idosell_search_products",
  "output_schema": {},
  "title": "Search products"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "title": "Set order status"
  },
  "description": "WRITE: change the status of one order (for example to packed, ready or canceled). Setting the same status again has no further effect. The panel may send customer e-mails for some status changes. API: PUT /orders/orders.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "order_serial_number": {
     "description": "Order serial number (from idosell_search_orders).",
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "status": {
     "description": "The new order status.",
     "enum": [
      "new",
      "finished",
      "false",
      "lost",
      "on_order",
      "packed",
      "ready",
      "canceled",
      "payment_waiting",
      "delivery_waiting",
      "suspended",
      "joined",
      "finished_ext"
     ],
     "type": "string"
    }
   },
   "required": [
    "order_serial_number",
    "status"
   ],
   "type": "object"
  },
  "name": "idosell_set_order_status",
  "output_schema": {},
  "title": "Set order status"
 }
]
