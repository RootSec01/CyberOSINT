 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Search live Belgian or Luxembourg legal jobs on LexGO by keywords and filters. q works best with one to three keywords, such as advocaat, juriste Bruxelles or M&A. Every word has to match a job's title, employer, practice area, function, city or region, in Dutch, French or English, and generic words such as jobs, vacature or legal are ignored. Returns 10 compact results without descriptions unless limit says otherwise. get_job returns a vacancy's full description. click_url is the link to the vacancy on LexGO.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "contract": {
     "enum": [
      "permanent",
      "temporary",
      "self_employed"
     ],
     "type": "string"
    },
    "cursor": {
     "type": "string"
    },
    "discipline_id": {
     "description": "Practice-area id from GET /api/v1/taxonomies.",
     "type": "integer"
    },
    "domain": {
     "enum": [
      "be",
      "lu"
     ],
     "type": "string"
    },
    "experience_id": {
     "description": "Experience band id from GET /api/v1/taxonomies (0 unknown, 1 0-3 years, 2 3-6, 3 +6).",
     "type": "integer"
    },
    "function_id": {
     "type": "integer"
    },
    "language": {
     "description": "Posting content locale (nl/fr/en), not required spoken languages.",
     "enum": [
      "nl",
      "fr",
      "en"
     ],
     "type": "string"
    },
    "limit": {
     "default": 10,
     "maximum": 50,
     "minimum": 1,
     "type": "integer"
    },
    "q": {
     "description": "One to three keywords, such as advocaat, juriste Bruxelles or M&A. Every word has to match a job's title, employer name, practice area, function, city or region, in Dutch, French or English. Simple plurals match, and generic words such as jobs, vacature, legal or Belgium are ignored; with nothing left, q is ignored. A word in no job gives no results. LIKE wildcards are treated as characters.",
     "maxLength": 80,
     "type": "string"
    },
    "region_id": {
     "description": "Region id: 1 Brussels, 2 Antwerp, 3 Flemish Brabant, 4 East Flanders, 5 West Flanders, 6 Limburg, 7 Walloon Brabant, 8 Namur, 9 Hainaut, 10 Liège, 11 Luxembourg, 12 Luxembourg (country), 13 Netherlands, 14 France, 15 Other country. 11 is the Belgian province, 12 the country. A province also matches jobs posted for a whole area (Flanders, Wallonia, Belgium), which list every province they cover in regions.",
     "type": "integer"
    },
    "remote": {
     "type": "boolean"
    },
    "work_environment_id": {
     "description": "Employer-type id from GET /api/v1/taxonomies.",
     "type": "integer"
    }
   },
   "required": [],
   "type": "object"
  },
  "name": "search_jobs",
  "output_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": true,
   "properties": {
    "jobs": {
     "items": {
      "additionalProperties": true,
      "properties": {
       "click_url": {
        "type": "string"
       },
       "id": {
        "type": "integer"
       },
       "summaries": {
        "type": "object"
       },
       "titles": {
        "type": "object"
       },
       "url": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "type": "array"
    },
    "next_cursor": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "type": "object"
  },
  "title": "Search LexGO jobs"
 }
]
