   "title": "Mark an adventure"
  },
  "description": "Add a published adventure to the signed-in member's bucket list or mark it as done, by slug (from search_adventures). Optional notes, completed_at (for done) and visibility (public, profile_only or private). Anything omitted keeps what is stored: visibility (public for a new entry), notes and the completion date. Repeating a call changes nothing. Requires sign-in.",
  "execution": {
   "taskSupport": "forbidden"
  },
  "input_schema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "additionalProperties": false,
   "properties": {
    "completed_at": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "format": "date-time",
       "type": "string"
      }
     ]
    },
    "notes": {
     "maxLength": 1000,
     "type": "string"
    },
    "slug": {
     "pattern": "^[a-z0-9-]{1,200}$",
     "type": "string"
    },
    "status": {
     "enum": [
      "done",
      "bucket_list"
     ],
     "type": "string"
    },
    "visibility": {
     "enum": [
      "public",
      "profile_only",
      "private"
     ],
     "type": "string"
    }
   },
   "required": [
    "slug",
    "status"
   ],
   "type": "object"
  },
  "name": "mark_adventure",
  "output_schema": {},
