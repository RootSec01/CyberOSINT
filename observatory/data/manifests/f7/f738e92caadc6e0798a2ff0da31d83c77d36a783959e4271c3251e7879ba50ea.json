 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "자재 검색(search materials)"
  },
  "description": "짓닷(jitdot.com)에 공개된 인테리어 자재(타일 · 마루 · 카펫타일 · LVT · 포보 · 욕실도기 · 벽재 · 부자재)를 조건으로 찾는다. 규격 · 재질 · 마감 값은 list_filters 가 돌려준 값만 쓴다. 욕실도기 · 벽재 · 부자재는 규격 · 재질 · 마감보다 분류와 낱말(하위분류 이름 · 제조사 · 색)로 찾는다. sale_unit 은 주문 단위(타일 · 바닥재는 박스)이고 consumer_price.unit 은 가격 단위다. 가격은 공개된 소비자가가 있는 자재에만 붙고 회원 등급 가격은 없다. 재고는 수량이 아니라 「재고 있음 · 재고 확인 필요 · 품절」이며 응답 시각 기준이다. 사람에게 답할 때는 짓닷코드와 표시명을 그대로 쓰고 urls.document 주소를 함께 준다. 추천 이유가 필요한 대화형 검색은 짓닷의 자재 검색 AI 짓피티(https://jitdot.com/jitpt)에서 한다.",
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "category": {
     "description": "분류(category): 타일(tile) · 마루(wood flooring) · 카펫타일(carpet tile) · LVT · 포보(Forbo linoleum) · 욕실도기(bathroom fixtures: 양변기 · 세면기 · 소변기 · 수전 · 샤워기 · 액세서리 세트 · 거울 · 거울장 · 욕실 천장(SMC)) · 벽재(wall finishes: 벽지 · 필름 · 샘플북) · 부자재(installation supplies: 접착제·압착시멘트 · 줄눈 · 실리콘·실란트 · 몰딩·걸레받이 · 평탄클립 · 하지재 · 배수구·육가). list_filters 가 돌려준 값을 그대로 써도 된다",
     "enum": [
      "타일",
      "마루",
      "카펫타일",
      "LVT",
      "포보",
      "욕실도기",
      "벽재",
      "부자재",
      "포보(LVS)"
     ],
     "type": "string"
    },
    "finish": {
     "description": "마감(finish): 무광(matte) · 유광(glossy) · 반광(semi-gloss)",
     "enum": [
      "무광",
      "유광",
      "반광"
     ],
     "type": "string"
    },
    "has_sketchup": {
     "default": false,
     "description": "스케치업 .skm 을 받을 수 있는 자재만(SketchUp material available)",
     "type": "boolean"
    },
    "in_stock_only": {
     "default": false,
     "description": "재고 있는 자재를 먼저 채우고, 모자라면 재고 확인 필요 자재를 뒤에 붙인다. 품절은 뺀다",
     "type": "boolean"
    },
    "limit": {
     "default": 10,
     "maximum": 24,
     "minimum": 1,
     "type": "integer"
    },
    "material": {
     "description": "재질(material). list_filters 가 돌려준 값만. 예: 포세린 · 도기질 · 원목 · 마모륨",
     "maxLength": 20,
     "type": "string"
    },
    "page": {
     "default": 1,
     "maximum": 5,
     "minimum": 1,
     "type": "integer"
    },
    "query": {
     "description": "표시명 · 색 이름에서 찾을 낱말(keywords). 예: 콘크리트룩 그레이 · 테라조 · 양변기",
     "maxLength": 100,
     "type": "string"
    },
    "size": {
     "description": "가로x세로(size in mm). 순서는 상관없다. 예: 600x600 · 300x600",
     "pattern": "^[0-9][0-9,]*(\\.[0-9]+)?\\s*[xX×*]\\s*[0-9][0-9,]*(\\.[0-9]+)?$",
     "type": "string"
    }
   },
   "type": "object"
  },
