 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false,
   "title": "Request a B.R.M contact, confirmed by email"
  },
  "description": "Records a request for the B.R.M team: 'appointment' (private visit of the manufacture), 'quote' (personalised quote by email) or 'special_request' (anything the configurator does not offer; the workshop checks feasibility). B.R.M emails the contact address a link to confirm the request (valid 72 h); the B.R.M team receives the request, and contacts the person, only after the recipient confirms it from that email, and for an appointment the confirmation page shows the booking link. Returns request_id, status 'awaiting_user_confirmation' and message_for_user (a summary for the user). user_consent=true records that the user agreed to share their email address; the email confirmation is what releases the request. Not an order and no payment. Limited to a few requests per day per email address; an idempotency_key makes retries safe and returns the request's current status.",
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "configuration": {
     "additionalProperties": false,
     "properties": {
      "engraving": {
       "description": "Optional engraving text (not priced, not rendered).",
       "maxLength": 24,
       "type": "string"
      },
      "model": {
       "description": "model_id from list_models, e.g. 'v6-44-sa'.",
       "type": "string"
      },
      "options": {
       "description": "option_id values from describe_model. Unset components keep their default.",
       "items": {
        "type": "string"
       },
       "maxItems": 40,
       "type": "array"
      }
     },
     "required": [
      "model"
     ],
     "type": "object"
    },
    "contact": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "format": "email",
       "type": "string"
      },
      "name": {
       "maxLength": 120,
       "type": "string"
      },
      "phone": {
       "maxLength": 40,
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "country": {
     "type": "string"
    },
    "idempotency_key": {
     "maxLength": 80,
     "type": "string"
    },
    "kind": {
     "enum": [
      "appointment",
      "quote",
      "special_request"
     ],
     "type": "string"
    },
    "lang": {
     "default": "en",
     "enum": [
      "fr",
      "en",
      "de",
      "es",
      "it",
      "nl",
      "pt",
      "ja",
      "ko",
      "zh",
      "ar",
      "hi"
     ],
     "type": "string"
    },
    "message": {
     "description": "What the user wants, in their words, precise enough for the workshop. Shown to the recipient on the confirmation page, not in the email.",
     "maxLength": 2000,
     "minLength": 10,
     "type": "string"
    },
    "user_consent": {
     "const": true,
     "description": "The user agreed to share their email address and be contacted.",
     "type": "boolean"
    }
   },
   "required": [
    "kind",
    "contact",
    "message",
    "user_consent"
   ],
   "type": "object"
  },
  "name": "submit_request",
  "output_schema": {
   "properties": {
    "confirmation": {
     "properties": {
      "channel": {
       "const": "email"
      },
      "valid_hours": {
       "type": "integer"
      }
     },
     "type": "object"
    },
    "duplicate": {
     "type": "boolean"
    },
    "expires_at": {
     "description": "Deadline for the recipient's confirmation.",
     "format": "date-time",
     "type": [
      "string",
      "null"
     ]
    },
    "explanation": {
     "type": "string"
    },
    "idempotent_replay": {
     "type": "boolean"
    },
    "is_order": {
     "const": false
    },
    "kind": {
     "enum": [
      "appointment",
      "quote",
      "special_request"
     ],
     "type": "string"
    },
    "message_for_user": {
     "description": "A summary for the user of what happens next.",
     "type": "string"
    },
    "next_step": {
     "properties": {
      "text": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "privacy": {
     "type": "string"
    },
    "request_id": {
     "examples": [
      "AG-3F9A12C0"
     ],
     "type": "string"
    },
    "status": {
     "description": "awaiting_user_confirmation: B.R.M emailed the address given and the team has not received the request; confirmed: the recipient confirmed it and the team has received it.",
     "enum": [
      "awaiting_user_confirmation",
      "confirmed",
      "expired",
      "cancelled",
      "confirmation_email_failed"
     ],
     "type": "string"
    }
   },
   "type": "object"
  },
  "title": "Request a B.R.M contact, confirmed by email"
 },
