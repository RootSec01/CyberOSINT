       "items": {
        "type": "string"
       },
       "maxItems": 40,
       "type": "array"
      }
     },
     "required": [
      "model"
     ],
     "type": "object"
    },
    "country": {
     "description": "ISO-3166 alpha-2, e.g. 'US'.",
     "type": "string"
    },
    "display_currency": {
     "description": "Optional ISO-4217 code for an indicative converted display price; billing currency always follows the delivery country.",
     "maxLength": 3,
     "type": "string"
    },
    "lang": {
     "default": "en",
     "enum": [
      "fr",
      "en",
      "de",
      "es",
      "it",
