 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "List B.R.M watches in stock, ready to ship"
  },
  "description": "Lists the B.R.M watches that are in stock and ship right away, as listed on brm-chronographes.com: name, reference, collection, price in the billing currency of the DELIVERY country (French VAT inside the EU, 0% VAT outside the EU with duties payable by the buyer; same rule as quote_configuration), image, product page link (product_url, where the user can buy the watch) and the delivery window B.R.M publishes for watches in stock, which is an estimate and not a fixed delivery date. Watches already sold or reserved are not listed. Optional filters: collection or model name, and max_price in the billing currency. Prices are indicative; the checkout on brm-chronographes.com is authoritative.",
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "collection": {
     "description": "Optional collection or model name, e.g. 'V6', 'GF7', 'BM6', 'V6-44'.",
     "maxLength": 40,
     "type": "string"
    },
    "country": {
     "description": "Delivery country, ISO-3166 alpha-2, e.g. 'US'. Sets the currency and VAT of the prices.",
     "maxLength": 60,
     "type": "string"
    },
    "lang": {
     "default": "en",
     "enum": [
      "fr",
      "en",
      "de",
      "es",
      "it",
      "nl",
      "pt",
      "ja",
      "ko",
      "zh",
      "ar",
      "hi"
     ],
     "type": "string"
    },
    "limit": {
     "default": 12,
     "maximum": 30,
     "minimum": 1,
     "type": "integer"
    },
    "max_price": {
     "description": "Optional maximum price, in the billing currency of the delivery country.",
     "exclusiveMinimum": 0,
     "type": "number"
    }
   },
   "required": [
    "country"
   ],
   "type": "object"
  },
  "name": "list_in_stock_watches",
  "output_schema": {
   "properties": {
    "billing_currency": {
     "type": "string"
    },
    "binding": {
     "const": false
    },
    "count": {
     "description": "Watches returned (at most `limit`).",
     "type": "integer"
    },
    "delivery_country": {
     "type": "string"
    },
    "lead_time": {
     "description": "The delivery window published for watches in stock (an estimate, not a fixed date), with the delivery page `url`.",
     "properties": {
      "christmas": {
       "properties": {
        "delivered_by": {
         "format": "date",
         "type": "string"
        },
        "order_by": {
         "format": "date",
         "type": "string"
        }
       },
       "type": "object"
      },
      "text": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      },
      "window": {
       "properties": {
        "from": {
         "format": "date",
         "type": "string"
        },
        "to": {
         "format": "date",
         "type": "string"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "legal_notice": {
     "type": [
      "string",
      "null"
     ]
    },
    "note": {
     "type": "string"
    },
    "tax_regime": {
     "properties": {
      "vat_included": {
       "type": "boolean"
      },
      "vat_rate_percent": {
       "type": "number"
      },
      "zone": {
       "enum": [
        "france",
        "eu_intra",
        "ue_oss",
        "dom_tom",
        "export"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "total_matching": {
     "description": "Models in stock matching the filters, before `limit`.",
     "type": "integer"
    },
    "watches": {
     "items": {
      "properties": {
       "availability": {
        "const": "in_stock"
       },
       "collection": {
        "type": [
         "string",
         "null"
        ]
       },
       "currency": {
        "type": "string"
       },
       "delivery_window": {
        "properties": {
         "from": {
          "format": "date",
          "type": "string"
         },
         "to": {
          "format": "date",
          "type": "string"
         }
        },
        "type": "object"
       },
       "image_url": {
        "format": "uri",
        "type": [
         "string",
         "null"
        ]
       },
       "name": {
        "type": "string"
       },
       "price": {
        "type": "number"
       },
       "price_before_discount": {
        "description": "Present when a promotion shown on the site applies.",
        "type": "number"
       },
       "price_formatted": {
        "type": "string"
       },
       "product_url": {
        "description": "The product page on brm-chronographes.com.",
        "format": "uri",
        "type": "string"
       },
       "reference": {
        "type": "string"
       },
       "vat_included": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "type": "array"
    }
   },
   "type": "object"
  },
  "title": "List B.R.M watches in stock, ready to ship"
 },
