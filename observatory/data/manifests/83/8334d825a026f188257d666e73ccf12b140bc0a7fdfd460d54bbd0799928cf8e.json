   "additionalProperties": false,
   "properties": {
    "lang": {
     "default": "en",
     "enum": [
      "fr",
      "en",
      "de",
      "es",
      "it",
      "nl",
      "pt",
      "ja",
      "ko",
      "zh",
      "ar",
      "hi"
     ],
     "type": "string"
    },
    "model": {
     "type": "string"
    }
   },
   "required": [
    "model"
   ],
   "type": "object"
  },
  "name": "describe_model",
  "output_schema": {
   "properties": {
    "base_price_eur": {
     "type": "number"
    },
    "components": {
     "items": {
      "properties": {
       "component_id": {
        "type": "string"
       },
       "conditional": {
        "type": "boolean"
       },
       "depends_on": {
        "description": "The component exists only if ONE of these option_ids is selected.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "is_engraving": {
        "type": "boolean"
       },
       "name": {
        "type": "string"
       },
       "options": {
        "items": {
         "properties": {
          "exclusive_group": {
           "description": "At most one option per group.",
           "type": "string"
          },
          "is_default": {
           "type": "boolean"
          },
          "name": {
           "type": "string"
          },
          "option_id": {
           "description": "Opaque id to send back. May look like 'V6-SA-B-GTS' or '#1508'.",
           "type": "string"
          },
          "surcharge_eur": {
           "type": "number"
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       "parent_component_id": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     },
     "type": "array"
    },
    "diameter_mm": {
     "type": [
      "integer",
      "null"
     ]
    },
    "lang": {
     "type": "string"
    },
    "model_id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "rules": {
     "additionalProperties": {
      "type": "string"
     },
     "type": "object"
    }
   },
   "type": "object"
  },
  "title": "Describe a model's components and options"
 },
 {
