[
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false,
   "title": "Prepare an order the customer confirms by email"
  },
  "description": "Prepares an order of this configured watch for the user, with the name, email and delivery address the user agreed to share with B.R.M (user_consent=true). B.R.M emails the user a summary with a 'Confirm my order' button (link valid 72 h); there the user chooses card, interest-free instalments (Alma under EUR 2,000, Pledg from EUR 2,000, where available), a 20% deposit (watch from EUR 3,000) or bank transfer (EUR only), and pays B.R.M on B.R.M's secure payment page. The price is computed by B.R.M for the delivery country (currency and VAT follow the delivery country). Returns order_id, status 'awaiting_customer_confirmation', and message_for_user (a summary for the user). The order is not placed until the user confirms from the email; the tool takes no payment details and returns no delivery date. Limited to a few orders per day per email; an idempotency_key makes retries safe.",
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "configuration": {
     "additionalProperties": false,
     "properties": {
      "engraving": {
       "description": "Optional engraving text (not priced, not rendered).",
       "maxLength": 24,
       "type": "string"
      },
      "model": {
       "description": "model_id from list_models, e.g. 'v6-44-sa'.",
       "type": "string"
      },
      "options": {
       "description": "option_id values from describe_model. Unset components keep their default.",
       "items": {
        "type": "string"
       },
       "maxItems": 40,
       "type": "array"
      }
     },
     "required": [
      "model"
     ],
     "type": "object"
    },
    "customer": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "format": "email",
       "maxLength": 200,
       "type": "string"
      },
      "first_name": {
       "maxLength": 60,
       "type": "string"
      },
      "last_name": {
       "maxLength": 60,
       "type": "string"
      },
      "phone": {
       "maxLength": 30,
       "type": "string"
      }
     },
     "required": [
      "email",
      "first_name",
      "last_name"
     ],
     "type": "object"
    },
    "idempotency_key": {
     "maxLength": 80,
     "type": "string"
    },
    "lang": {
     "default": "en",
     "enum": [
      "fr",
      "en",
      "de",
      "es",
      "it",
      "nl",
      "pt",
      "ja",
      "ko",
      "zh",
      "ar",
      "hi"
     ],
     "type": "string"
    },
    "shipping_address": {
     "additionalProperties": false,
     "properties": {
      "city": {
       "maxLength": 80,
       "type": "string"
      },
      "country": {
       "description": "ISO-3166 alpha-2, e.g. 'US'.",
       "pattern": "^[A-Za-z]{2}$",
       "type": "string"
      },
      "line1": {
       "maxLength": 120,
       "type": "string"
      },
      "line2": {
       "maxLength": 120,
       "type": "string"
      },
      "postal_code": {
       "maxLength": 16,
       "type": "string"
      },
      "region": {
       "maxLength": 60,
       "type": "string"
      }
     },
     "required": [
      "line1",
      "postal_code",
      "city",
      "country"
     ],
     "type": "object"
    },
    "user_consent": {
     "const": true,
     "type": "boolean"
    }
   },
   "required": [
    "configuration",
    "customer",
    "shipping_address",
    "user_consent"
   ],
   "type": "object"
  },
  "name": "create_order",
  "output_schema": {
   "properties": {
    "confirmation": {
     "properties": {
      "channel": {
       "const": "email"
      },
      "valid_hours": {
       "type": "integer"
      }
     },
     "type": "object"
    },
    "created_at": {
     "format": "date-time",
     "type": "string"
    },
    "duplicate": {
     "type": "boolean"
    },
    "expires_at": {
     "description": "Deadline for the user's confirmation.",
     "format": "date-time",
     "type": "string"
    },
    "explanation": {
     "type": "string"
    },
    "idempotent_replay": {
     "type": "boolean"
    },
    "indicative_price": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "binding": {
       "const": false
      },
      "currency": {
       "type": "string"
      },
      "formatted": {
       "type": "string"
      },
      "legal_notice": {
       "type": [
        "string",
        "null"
       ]
      },
      "shipping": {
       "type": "number"
      },
      "vat_included": {
       "type": "boolean"
      },
      "vat_rate_percent": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "is_order": {
     "const": false,
     "description": "Always false here: the order exists only after the user's confirmation."
    },
    "is_paid": {
     "type": "boolean"
    },
    "lead_time": {
     "description": "No firm number of weeks is given by this API: show `url` (the delivery page of brm-chronographes.com, in the user's language) for lead times.",
     "properties": {
      "text": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "type": "object"
    },
    "message_for_user": {
     "description": "A summary for the user.",
     "type": "string"
    },
    "order_id": {
     "type": "string"
    },
    "status": {
     "enum": [
      "awaiting_customer_confirmation",
      "confirming",
      "confirmed_awaiting_payment",
      "paid",
      "expired",
      "cancelled",
      "confirmation_email_failed",
      "needs_assistance"
     ],
     "type": "string"
    }
   },
   "type": "object"
  },
  "title": "Prepare an order the customer confirms by email"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false,
   "title": "Create a link that reopens this watch"
  },
  "description": "Returns configurator_url (opens this exact watch in the configurator on brm-chronographes.com, where the user can adjust it and add it to the basket; this is the link meant for the user) and preview_url (a public presentation page with rotation, shared by every identical configuration). Idempotent. Sharing is not ordering.",
  "input_schema": {
   "additionalProperties": false,
   "properties": {
    "configuration": {
     "additionalProperties": false,
     "properties": {
      "engraving": {
       "description": "Optional engraving text (not priced, not rendered).",
       "maxLength": 24,
       "type": "string"
      },
      "model": {
       "description": "model_id from list_models, e.g. 'v6-44-sa'.",
       "type": "string"
      },
      "options": {
       "description": "option_id values from describe_model. Unset components keep their default.",
       "items": {
        "type": "string"
       },
       "maxItems": 40,
       "type": "array"
      }
     },
     "required": [
      "model"
     ],
     "type": "object"
    },
    "lang": {
     "default": "en",
     "enum": [
      "fr",
      "en",
      "de",
      "es",
      "it",
      "nl",
      "pt",
      "ja",
      "ko",
      "zh",
      "ar",
      "hi"
     ],
     "type": "string"
    },
    "view": {
     "default": 0,
     "maximum": 29,
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "configuration"
   ],
   "type": "object"
  },
  "name": "create_share_link",
  "output_schema": {
   "properties": {
    "configurator_url": {
     "description": "Reopens this exact watch on brm-chronographes.com.",
     "format": "uri",
     "type": "string"
    },
    "image_url": {
     "format": "uri",
     "type": [
      "string",
      "null"
     ]
    },
    "is_order": {
     "const": false
    },
    "note": {
     "type": "string"
    },
    "offer": {
     "description": "An offer of brm-chronographes.com that applies to this watch right now (e.g. Black Friday), limited in time and in number of watches; confirmed when the order is placed.",
     "properties": {
      "discount_eur": {
       "type": "number"
      },
      "limited_to_watches": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "price_eur_incl_fr_vat": {
       "type": "number"
      },
      "price_without_offer": {
       "description": "In the billing currency of the delivery country.",
       "type": "number"
      },
      "price_without_offer_eur_incl_fr_vat": {
       "type": "number"
      },
      "valid_until": {
       "format": "date-time",
       "type": "string"
      }
     },
     "type": "object"
    },
    "preview_url": {
     "description": "Public page shared by every identical configuration; carries no user data.",
     "format": "uri",
     "type": [
      "string",
      "null"
     ]
    },
    "total_price_eur": {
     "type": "number"
    }
   },
   "type": "object"
  },
  "title": "Create a link that reopens this watch"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
