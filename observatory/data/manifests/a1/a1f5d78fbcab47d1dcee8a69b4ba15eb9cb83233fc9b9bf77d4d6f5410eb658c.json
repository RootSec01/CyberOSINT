   "title": "Find bullion"
  },
  "description": "The \"Find your bullion\" picker: products matching a metal, form, size, purpose or sort order, as on bulliontradingllc.com/find-your-bullion/, with both prices, in/out of stock and the best price per ounce. Sizes look like \"1-oz\", \"1-10-oz\", \"10-oz\", \"1-kilo\", \"1-gram\". Use when the user describes what they want (metal, form, size, budget) and needs matching Bullion Trading LLC products. Read-only.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "metal": {
     "description": "gold, silver, platinum or palladium",
     "enum": [
      "gold",
      "silver",
      "platinum",
      "palladium"
     ],
     "type": "string"
    },
    "purpose": {
     "description": "first purchase, a gift, or building a stack",
     "enum": [
      "first",
      "gift",
      "stack"
     ],
     "type": "string"
