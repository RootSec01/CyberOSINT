   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "metal": {
     "description": "gold, silver, platinum or palladium",
     "enum": [
      "gold",
      "silver",
      "platinum",
      "palladium"
     ],
     "type": "string"
    },
    "product": {
     "description": "Product id, slug or URL",
     "maxLength": 300,
     "minLength": 1,
