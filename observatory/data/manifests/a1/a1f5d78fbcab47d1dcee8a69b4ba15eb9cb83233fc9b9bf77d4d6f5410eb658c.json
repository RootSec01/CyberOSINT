 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "Estimate sales tax"
  },
  "description": "Whether a US state charges sales tax on bullion, the threshold if any, and an estimate for an order amount. Estimate only; the final tax is shown at checkout. Includes the state page link. Use when the user asks about US sales tax on a bullion purchase. Read-only; not tax advice.",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "amount": {
     "description": "Order amount in USD",
     "maximum": 10000000,
     "minimum": 0,
     "type": "number"
    },
    "form": {
     "description": "Product form; some states tax coins and bars differently",
     "enum": [
      "coin",
      "bar",
      "round"
     ],
     "type": "string"
    },
    "metal": {
     "description": "gold, silver, platinum or palladium",
     "enum": [
      "gold",
      "silver",
      "platinum",
      "palladium"
     ],
     "type": "string"
    },
    "state": {
     "description": "US state: 2-letter code (NY) or name (New York)",
     "maxLength": 30,
     "minLength": 2,
     "type": "string"
    }
   },
   "required": [
    "state"
   ],
   "type": "object"
  },
  "name": "estimate_sales_tax",
  "output_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": {},
   "properties": {
    "disclaimer": {
     "const": "Estimate only. The final tax is shown at checkout.",
     "type": "string"
    },
    "estimate_tax": {
     "type": [
      "number",
      "null"
     ]
    },
    "notes": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "price_time": {
     "type": [
      "string",
      "null"
     ]
    },
    "rule_text": {
     "type": [
      "string",
      "null"
     ]
    },
    "source_url": {
     "type": "string"
    },
    "state": {
     "type": "string"
    },
    "taxable": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "const": "partly",
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "threshold_usd": {
     "type": [
      "number",
      "null"
     ]
    }
   },
   "required": [
    "source_url",
    "price_time",
    "notes",
    "state",
    "taxable",
    "threshold_usd",
    "rule_text",
    "estimate_tax",
    "disclaimer"
   ],
   "type": "object"
  },
  "title": "Estimate sales tax"
 },
