{
 "packages": [
  {"package": "@azure/mcp", "args": ["server", "start"]},
  {"package": "@browsermcp/mcp"},
  {"package": "@elastic/mcp-server-elasticsearch", "env": {"ES_URL": "http://localhost:9200", "ES_API_KEY": "unset"}},
  {"package": "@executeautomation/playwright-mcp-server"},
  {"package": "@heroku/mcp-server", "env": {"HEROKU_API_KEY": "unset"}},
  {"package": "@modelcontextprotocol/server-aws-kb-retrieval", "env": {"AWS_ACCESS_KEY_ID": "unset", "AWS_SECRET_ACCESS_KEY": "unset", "AWS_REGION": "us-east-1"}},
  {"package": "@modelcontextprotocol/server-brave-search", "env": {"BRAVE_API_KEY": "unset"}},
  {"package": "@modelcontextprotocol/server-everart", "env": {"EVERART_API_KEY": "unset"}},
  {"package": "@modelcontextprotocol/server-everything"},
  {"package": "@modelcontextprotocol/server-filesystem", "args": ["{workdir}"]},
  {"package": "@modelcontextprotocol/server-github", "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "unset"}},
  {"package": "@modelcontextprotocol/server-gitlab", "env": {"GITLAB_PERSONAL_ACCESS_TOKEN": "unset"}},
  {"package": "@modelcontextprotocol/server-google-maps", "env": {"GOOGLE_MAPS_API_KEY": "unset"}},
  {"package": "@modelcontextprotocol/server-memory"},
  {"package": "@modelcontextprotocol/server-postgres", "args": ["postgresql://localhost/unset"]},
  {"package": "@modelcontextprotocol/server-puppeteer"},
  {"package": "@modelcontextprotocol/server-sequential-thinking"},
  {"package": "@modelcontextprotocol/server-slack", "env": {"SLACK_BOT_TOKEN": "unset", "SLACK_TEAM_ID": "unset"}},
  {"package": "@notionhq/notion-mcp-server", "env": {"NOTION_TOKEN": "unset"}},
  {"package": "@playwright/mcp"},
  {"package": "@sentry/mcp-server", "args": ["--access-token=unset"]},
  {"package": "@upstash/context7-mcp"},
  {"package": "@wonderwhy-er/desktop-commander"},
  {"package": "chrome-devtools-mcp"},
  {"package": "exa-mcp-server", "env": {"EXA_API_KEY": "unset"}},
  {"package": "figma-developer-mcp", "args": ["--stdio"], "env": {"FIGMA_API_KEY": "unset"}},
  {"package": "firecrawl-mcp", "env": {"FIRECRAWL_API_KEY": "unset"}},
  {"package": "mcp-server-kubernetes"},
  {"package": "mongodb-mcp-server"},
  {"package": "tavily-mcp", "env": {"TAVILY_API_KEY": "unset"}}
 ]
}
